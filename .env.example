# NexVora Search Engine - Environment Configuration Template

# Server Port & Node Environment
PORT=3000
NODE_ENV=production

# Production PostgreSQL Connection URL
# On Render, this is automatically injected by Render PostgreSQL via render.yaml (fromDatabase: nexvora-postgres).
# No manual entry or copying required. In local development, if omitted, NexVora uses local persistent storage.
DATABASE_URL="postgres://username:password@hostname:5432/nexvora_db"

# GitHub Autonomous Polling (Primary Automatic Synchronization)
# Poll interval in seconds (Default: 300 seconds / 5 minutes)
GITHUB_POLL_INTERVAL_SEC=300

# Target GitHub repository hosting sources/ (e.g. "owner/repo" or leave blank for local sources/ directory)
GITHUB_REPO=""
GITHUB_BRANCH="main"
GITHUB_SOURCES_PATH="sources"

# Optional GitHub Personal Access Token (for higher rate limits or private source repositories)
GITHUB_TOKEN=""

# GitHub Webhook HMAC Secret (COMPLETELY OPTIONAL)
# NexVora synchronizes autonomously via polling; webhooks are purely optional.
GITHUB_WEBHOOK_SECRET=""

# Canonical Search Domain (MANDATORY NexVora Custom Search Domain)
# Automatically defaults to https://www.nexvora.com if unspecified
NEXT_PUBLIC_SITE_URL="https://www.nexvora.com"
VITE_SITE_URL="https://www.nexvora.com"

# Application Public Deployment URL
APP_URL="https://nexvora-search.onrender.com"
